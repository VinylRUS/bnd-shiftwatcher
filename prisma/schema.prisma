// Схема данных Табеля.
// Профили (сотрудники) и записи по дням. База — SQLite, файл задаётся
// переменной окружения DATABASE_URL (в Docker — том /data).
//
// Авторизация (v9): вход в профиль по 6-значному пинкоду. Пин хранится
// хешем (scrypt, см. src/lib/server/auth.ts); пока пин не установлен,
// первый вход выполняется по имени профиля, после чего сразу предлагается
// задать пин. Первый (старейший) профиль — админ: создаёт и управляет
// остальными профилями. Сессии — в таблице Session, токен в cookie.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id         String   @id
  name       String
  /// ставка ₽ за час; null — не задана
  rate       Float?
  defStart   String   @default("09:00")
  defEnd     String   @default("18:00")
  defLunch   Boolean  @default(true)
  defLunchMin Int     @default(60)
  defPlace   String   @default("Склад")
  /// хеш пинкода (scrypt), null — пин ещё не установлен (первый вход по имени)
  pinHash    String?
  /// админ создаёт профили и управляет ими (по умолчанию — первый профиль)
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  days       DayRow[]
  sessions   Session[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid())
  /// случайный токен из cookie tabel_session
  token     String   @unique
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([profileId])
  @@index([expiresAt])
}

model DayRow {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// дата дня в формате YYYY-MM-DD
  date      String
  /// true — выходной
  off       Boolean @default(false)
  /// "09:00"
  startTime String  @default("")
  /// "18:00"
  endTime   String  @default("")
  /// есть обед
  lunch     Boolean @default(false)
  /// длительность обеда, минут
  lunchMin  Int     @default(0)
  /// место работы, напр. "Склад"
  place     String  @default("")

  @@unique([profileId, date])
  @@index([profileId, date])
}
